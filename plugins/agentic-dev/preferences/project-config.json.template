{
  "_comment": "Optional. Copy to preferences/project-config.json. CLAUDE.md in the project always takes precedence - this is only a fallback for projects without a maintained CLAUDE.md.",
  "project": {
    "name": "",
    "stack": "",
    "package_manager": "npm"
  },
  "commands": {
    "dev": "npm run dev",
    "test": "npm test",
    "test_single": "npm test --",
    "lint": "npm run lint",
    "typecheck": "npm run typecheck",
    "build": "npm run build",
    "e2e": "npm run test:e2e",
    "migrate": "npm run db:migrate"
  },
  "environments": {
    "preview": "automatic per PR",
    "staging": "",
    "production": ""
  },
  "hosting": "vercel",
  "loop": {
    "spec_threshold_minutes": 30,
    "roadmap_now_max": 3,
    "ci_budget_minutes": 10,
    "health_watch_minutes": 10,
    "bundle_max_items": 5,
    "checkin_interval_minutes": 15
  },
  "deploy_gate": {
    "mode": "standard",
    "always_gate": []
  },
  "decisions": {
    "confidence_threshold": 70,
    "queue_file": "docs/decisions/QUEUE.md"
  },
  "backlog": {
    "store": "",
    "source_order": ["admin", "paying", "free", "anonymous"],
    "excellence_before_expansion": true
  },
  "testing": {
    "scoped_per_increment": true,
    "full_suite_at": "bundle",
    "full_suite_budget_minutes": 10
  },
  "review": {
    "require_separate_qa_contract": true,
    "block_on": [
      "correctness",
      "security",
      "test-integrity"
    ]
  },
  "learnings": {
    "upstream_repo": "steffenmaas/founder-os",
    "auto_prompt_after_incident": true
  }
}
